# Postgres (Neon)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# LLM
GEMINI_API_KEY=
WATCHDOCS_LLM_MODEL=gemini-2.5-flash
# Optional per-million-token price overrides used for cost logging
# WATCHDOCS_PRICE_INPUT_PER_M=0.30
# WATCHDOCS_PRICE_OUTPUT_PER_M=2.50

# Email (Resend)
RESEND_API_KEY=
WAITLIST_FROM_EMAIL=Watchdocs <hello@watchdocs.dev>

# Auth.js (GitHub App OAuth credentials)
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# GitHub App (installation flow)
GITHUB_APP_ID=
# Provide either the PEM directly (newlines escaped as \n) or base64-encode it
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_APP_SLUG=
GITHUB_APP_INSTALL_URL=
NEXT_PUBLIC_GITHUB_APP_INSTALL_URL=
GITHUB_WEBHOOK_SECRET=

# Inngest (queue). Local development auto-enables dev mode; set INNGEST_DEV=1
# explicitly if needed. Production needs both keys.
INNGEST_DEV=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
